{
    "name": "ROS 2 Development Container",
    "privileged": true,
    "remoteUser": "iotc",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "iotc"
        }
    },
    "workspaceFolder": "/home/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder}/radar_driver,target=/home/ros2_ws/src,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "llvm-vs-code-extensions.vscode-clangd",
                "twxs.cmake",
                "xaver.clang-format",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "KevinRose.vsc-python-indent"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}",
        "--device=/dev/ttyACM0:/dev/ttyACM0", 
        "--device=/dev/ttyACM1:/dev/ttyACM1", 
        "--group-add=dialout"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    "postStartCommand": "source /opt/ros/jazzy/setup.bash ; rosdep update && sudo rosdep install --from-paths /home/ros2_ws/src --ignore-src -y && sudo chown -R $(whoami) /home/ros2_ws"
}